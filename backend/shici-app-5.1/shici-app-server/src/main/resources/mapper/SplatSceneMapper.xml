<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.shici.mapper.SplatSceneMapper">

    <resultMap id="SplatSceneMap" type="com.shici.domain.SplatScene">
        <id property="id" column="id"/>
        <result property="poemId" column="poem_id"/>
        <result property="title" column="title"/>
        <result property="author" column="author"/>
        <result property="dynasty" column="dynasty"/>
        <result property="description" column="description"/>
        <result property="coverUrl" column="cover_url"/>
        <result property="splatUrl" column="splat_url"/>
        <result property="fileType" column="file_type"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectById" resultMap="SplatSceneMap">
        SELECT
            id,
            poem_id,
            title,
            author,
            dynasty,
            description,
            cover_url,
            splat_url,
            file_type,
            status,
            created_at,
            updated_at
        FROM splat_scene
        WHERE id = #{id}
          AND status = 1
            LIMIT 1
    </select>

    <select id="selectList" resultMap="SplatSceneMap">
        SELECT
        id,
        poem_id,
        title,
        author,
        dynasty,
        description,
        cover_url,
        splat_url,
        file_type,
        status,
        created_at,
        updated_at
        FROM splat_scene
        WHERE status = 1
        <if test="kw != null and kw != ''">
            AND (
            title LIKE CONCAT('%', #{kw}, '%')
            OR author LIKE CONCAT('%', #{kw}, '%')
            OR dynasty LIKE CONCAT('%', #{kw}, '%')
            )
        </if>
        ORDER BY id DESC
    </select>

</mapper>